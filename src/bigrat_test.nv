// Тесты bigrat — точные рациональные числа поверх BigInt.
// План 240 (docs/plans/240-bigrat.md в репе nova).
// Ф.0: пины компилябельности — (а) value-record с двумя BigInt-полями,
// (а2) статик-конструкторы + instance-метод на одном value-record типе,
// (б) операторный desugar + - *, (в) кросс-модульный DivError из bignum,
// (г) бланкет `fn[T Ints] T @to_bigrat()` → `@to_bigint()` в пакетном CU.

module bignum.bigrat_test

import bignum.{Neg, Zero, Pos}
import bignum.bigint.{BigInt}
import std.math.int128.{i128}
import std.prelude.core.{Option, Some, None}
import bignum.bigrat.{BigRat}
import bignum.bigdecimal.{BigDecimal, MathContext, RoundingMode, HalfEven, HalfUp, HalfDown, Down, Up, Ceiling, Floor}
import bignum.bigfloat.{BigFloat, PrecisionContext}

fn br(n int, d int) -> BigRat => BigRat.new(n.to_bigint(), d.to_bigint())!!

// ──────────────────────────────────────────────────────────────────────────
// Ф.0 пин (а): value-record с двумя BigInt-полями собирается и читается
// ──────────────────────────────────────────────────────────────────────────

test "Ф.0(a): value-record с двумя BigInt-полями — num/den читаются" {
    ro r = BigRat.new((1).to_bigint(), (2).to_bigint())!!
    assert(r.num.equal((1).to_bigint()))
    assert(r.den.equal((2).to_bigint()))
    assert(r.num().equal((1).to_bigint()))
    assert(r.den().equal((2).to_bigint()))
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.0 пин (а2): статик-конструкторы + instance-метод на одном типе
// ──────────────────────────────────────────────────────────────────────────

test "Ф.0(a2): BigRat.zero()/one()/new() + @equal на одном value-record" {
    ro z = BigRat.zero()
    assert(z.num().is_zero())
    assert(z.den().is_one())

    ro o = BigRat.one()
    assert(o.num().is_one())
    assert(o.den().is_one())

    ro a = br(1, 2)
    ro b = br(1, 2)
    ro c = br(2, 3)
    assert(a.equal(b))
    assert(!a.equal(c))
    assert(a == b)
}

test "Ф.0(a2): new нормализует знак — -1/-2 == 1/2, 0/5 == 0/1" {
    ro a = BigRat.new((-1).to_bigint(), (-2).to_bigint())!!
    assert(a.num().equal((1).to_bigint()))
    assert(a.den().equal((2).to_bigint()))
    ro b = BigRat.new((0).to_bigint(), (5).to_bigint())!!
    assert(b.num().is_zero())
    assert(b.den().is_one())
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.0 пин (в): DivError виден в bignum.bigrat (кросс-модульный импорт)
// ──────────────────────────────────────────────────────────────────────────

test "Ф.0(b): new(x, 0) → Err(DivisionByZero)" {
    match BigRat.new((1).to_bigint(), (0).to_bigint()) {
        Err(DivisionByZero) => assert(true)
        _ => assert(false)
    }
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.0 пин (б): операторный desugar + - * на новом типе
// ──────────────────────────────────────────────────────────────────────────

test "Ф.0(б): операторы + - * работают на BigRat" {
    ro a = br(1, 2)
    ro b = br(1, 3)
    ro s = a + b
    assert(s.num().equal((5).to_bigint()))
    assert(s.den().equal((6).to_bigint()))

    ro d = a - b
    assert(d.num().equal((1).to_bigint()))
    assert(d.den().equal((6).to_bigint()))

    ro m = a * b
    assert(m.num().equal((1).to_bigint()))
    assert(m.den().equal((6).to_bigint()))
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.0 пин (г): бланкет T @to_bigrat зовёт бланкет @to_bigint из generic-тела
// ──────────────────────────────────────────────────────────────────────────

test "Ф.0(г): бланкет T @to_bigrat() (generic-из-generic) — int" {
    ro r = (42).to_bigrat()
    assert(r.num().equal((42).to_bigint()))
    assert(r.den().is_one())
    ro neg = (-7).to_bigrat()
    assert(neg.num().equal((-7).to_bigint()))
    ro z = (0).to_bigrat()
    assert(z.num().is_zero())
    ro big = (0xFFFFFFFFFFFFFFFF as u64).to_bigrat()
    assert(!big.num().is_zero())
}

test "Ф.0(г): i128 @to_bigrat() — отдельная перегрузка" {
    ro r = i128(0, 7).to_bigrat()
    assert(r.num().equal((7).to_bigint()))
    assert(r.den().is_one())
    ro z = i128().to_bigrat()
    assert(z.num().is_zero())
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.2: нормальная форма (НОД-сокращение), предикаты, @compare/@hash/@abs
// ──────────────────────────────────────────────────────────────────────────

test "Ф.2: new сокращает НОД — 2/4 == 1/2, -6/8 == -3/4" {
    ro a = BigRat.new((2).to_bigint(), (4).to_bigint())!!
    assert(a.num().equal((1).to_bigint()))
    assert(a.den().equal((2).to_bigint()))

    ro b = BigRat.new((-6).to_bigint(), (8).to_bigint())!!
    assert(b.num().equal((-3).to_bigint()))
    assert(b.den().equal((4).to_bigint()))

    ro c = BigRat.new((12).to_bigint(), (18).to_bigint())!!
    assert(c.num().equal((2).to_bigint()))
    assert(c.den().equal((3).to_bigint()))
}

test "Ф.2: нормальная форма после знака — -1/-2 == 1/2, -2/4 == -1/2" {
    ro a = BigRat.new((-1).to_bigint(), (-2).to_bigint())!!
    assert(a.num().equal((1).to_bigint()))
    assert(a.den().equal((2).to_bigint()))
    ro b = BigRat.new((-2).to_bigint(), (4).to_bigint())!!
    assert(b.num().equal((-1).to_bigint()))
    assert(b.den().equal((2).to_bigint()))
}

test "Ф.2: @is_zero / @is_int / @sign" {
    ro z = BigRat.zero()
    assert(z.is_zero())
    assert(z.is_int())
    assert(z.sign() == Zero)

    ro h = br(1, 2)
    assert(!h.is_zero())
    assert(!h.is_int())
    assert(h.sign() == Pos)

    ro neg = br(-3, 5)
    assert(neg.sign() == Neg)

    ro five = br(5, 1)
    assert(five.is_int())
    assert(five.sign() == Pos)
}

test "Ф.2: @abs" {
    ro a = br(-3, 4)
    ro p = a.abs()
    assert(p.num().equal((3).to_bigint()))
    assert(p.den().equal((4).to_bigint()))
    assert(br(3, 4).abs().equal(p))
    assert(BigRat.zero().abs().is_zero())
}

test "Ф.2: @equal — разные представления одного значения после нормализации" {
    ro a = br(1, 2)
    ro b = BigRat.new((2).to_bigint(), (4).to_bigint())!!
    assert(a.equal(b))
    assert(a == b)
    ro c = BigRat.new((-1).to_bigint(), (-2).to_bigint())!!
    assert(a.equal(c))
    assert(a.hash() == c.hash())
}

test "Ф.2: @compare — кросс-умножение, знаки, дроби" {
    assert(br(1, 2).compare(br(1, 3)) > 0)
    assert(br(1, 3).compare(br(1, 2)) < 0)
    assert(br(2, 3).compare(br(4, 6)) == 0)
    assert(br(-1, 2).compare(br(0, 1)) < 0)
    assert(br(0, 1).compare(br(-1, 2)) > 0)
    assert(br(3, 4).compare(br(1, 1000000)) > 0)
    assert(br(-3, 4).compare(br(-1, 2)) < 0)
}

test "Ф.2: @hash согласован с @equal на нормальной форме" {
    ro a = br(3, 7)
    ro b = br(3, 7)
    ro c = br(7, 3)
    assert(a.equal(b))
    assert(a.hash() == b.hash())
    assert(!a.equal(c))
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.3: арифметика — @plus/@minus/@times/@div/@recip
// ──────────────────────────────────────────────────────────────────────────

test "Ф.3: @plus/@minus/@times — канонические вектора и нормальная форма" {
    ro a = br(1, 2)
    ro b = br(1, 3)
    ro s = a.plus(b)
    assert(s.num().equal((5).to_bigint()))
    assert(s.den().equal((6).to_bigint()))

    ro d = a.minus(b)
    assert(d.num().equal((1).to_bigint()))
    assert(d.den().equal((6).to_bigint()))

    ro m = a.times(b)
    assert(m.num().equal((1).to_bigint()))
    assert(m.den().equal((6).to_bigint()))
}

test "Ф.3: plus сокращает — 1/3 + 1/6 == 1/2" {
    ro s = br(1, 3).plus(br(1, 6))
    assert(s.equal(br(1, 2)))
    assert(s.num().equal((1).to_bigint()))
    assert(s.den().equal((2).to_bigint()))
}

test "Ф.3: знаки в плюс/минус — (-1/2) + (1/3), 0-слагаемые" {
    ro s = br(-1, 2).plus(br(1, 3))
    assert(s.equal(br(-1, 6)))

    ro z = BigRat.zero()
    assert(br(2, 3).plus(z).equal(br(2, 3)))
    assert(z.plus(br(2, 3)).equal(br(2, 3)))
    assert(br(2, 3).minus(z).equal(br(2, 3)))
    assert(z.minus(br(2, 3)).equal(br(-2, 3)))
}

test "Ф.3: @recip — нормальная форма и знак в числитель" {
    ro r = br(2, 3).recip()!!
    assert(r.equal(br(3, 2)))
    assert(r.num().equal((3).to_bigint()))
    assert(r.den().equal((2).to_bigint()))

    ro neg = br(-2, 5).recip()!!
    assert(neg.equal(br(-5, 2)))
    assert(neg.num().is_neg())
    assert(neg.den().is_pos())
}

test "Ф.3: @div — (a/b)*b == a, деление на ноль → Err" {
    ro a = br(2, 3)
    ro b = br(4, 5)
    ro q = a.div(b)!!
    assert(q.equal(br(5, 6)))
    assert(q.times(b).equal(a))

    match a.div(BigRat.zero()) {
        Err(DivisionByZero) => assert(true)
        _ => assert(false)
    }
    match BigRat.zero().recip() {
        Err(DivisionByZero) => assert(true)
        _ => assert(false)
    }
}

test "Ф.3: операторы + - * и деление дают нормальную форму" {
    ro x = br(2, 4).plus(br(2, 4))
    assert(x.equal(br(1, 1)))
    assert(x.den().is_one())

    ro y = br(1, 2).times(br(2, 3))
    assert(y.equal(br(1, 3)))

    ro c = br(1, 2).div(br(1, 2))!!
    assert(c.equal(br(1, 1)))
    assert(c.is_int())
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.4: строки — str @to_bigrat / @to_str / @to_int / @to_i128
// ──────────────────────────────────────────────────────────────────────────

test "Ф.4: str @to_bigrat — целые и p/q формы" {
    ro a = "5".to_bigrat()!!
    assert(a.equal(br(5, 1)))
    ro b = "-5".to_bigrat()!!
    assert(b.equal(br(-5, 1)))
    ro c = "1/2".to_bigrat()!!
    assert(c.equal(br(1, 2)))
    ro d = "-1/2".to_bigrat()!!
    assert(d.equal(br(-1, 2)))
    ro e = "1/-2".to_bigrat()!!
    assert(e.equal(br(-1, 2)))
    ro f = "2/4".to_bigrat()!!
    assert(f.equal(br(1, 2)))
    ro g = "0/5".to_bigrat()!!
    assert(g.is_zero())
    assert(g.den().is_one())
}

test "Ф.4: str @to_bigrat — ошибки парсинга" {
    match "".to_bigrat() {
        Err(Empty) => assert(true)
        _ => assert(false)
    }
    match "-".to_bigrat() {
        Err(OnlySign) => assert(true)
        _ => assert(false)
    }
    match "a/2".to_bigrat() {
        Err(InvalidCharacter) => assert(true)
        _ => assert(false)
    }
    match "1/0".to_bigrat() {
        Err(ZeroDenominator) => assert(true)
        _ => assert(false)
    }
    match "1/".to_bigrat() {
        Err(Empty) => assert(true)
        _ => assert(false)
    }
}

test "Ф.4: @to_str — p/q, целые без знаменателя, roundtrip" {
    assert(br(5, 1).to_str() == "5")
    assert(br(1, 2).to_str() == "1/2")
    assert(br(-3, 4).to_str() == "-3/4")
    assert(br(0, 1).to_str() == "0")
    ro s = "1234567891/9876543211"
    assert(s.to_bigrat()!!.to_str() == s)
}

test "Ф.4: @to_int / @to_i128 — trunc-к-нулю, None при переполнении" {
    assert(br(7, 2).to_int() == Some(3))
    assert(br(-7, 2).to_int() == Some(-3))
    assert(br(4, 2).to_int() == Some(2))
    assert(br(1, 2).to_int() == Some(0))
    assert(br(-1, 2).to_int() == Some(0))
    assert(br(7, 2).to_i128() == Some(i128(0, 3)))

    ro big = BigRat.new((1).to_bigint().shl(63), (1).to_bigint())!!
    assert(big.to_int() == None)
    ro huge = BigRat.new((1).to_bigint().shl(127), (1).to_bigint())!!
    assert(huge.to_i128() == None)
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.4: связка семьи — BigDecimal↔BigRat, BigFloat→BigRat
// ──────────────────────────────────────────────────────────────────────────

test "Ф.4: BigDecimal @to_bigrat — точная конверсия и нормализация" {
    ro r = "1.25".to_bigdecimal()!!.to_bigrat()
    assert(r.equal(br(5, 4)))
    ro big = "12.345".to_bigdecimal()!!.to_bigrat()
    assert(big.equal(BigRat.new((2469).to_bigint(), (200).to_bigint())!!))
    ro whole = "5".to_bigdecimal()!!.to_bigrat()
    assert(whole.equal(br(5, 1)))
    ro negscale = "1.5E+2".to_bigdecimal()!!.to_bigrat()
    assert(negscale.equal(br(150, 1)))
    ro z = "0.0".to_bigdecimal()!!.to_bigrat()
    assert(z.is_zero())
}

test "Ф.4: BigRat @to_bigdecimal(mc) — деление с округлением" {
    ro q = br(5, 4).to_bigdecimal(MathContext.new(10, HalfEven))
    assert(q.equal("1.25".to_bigdecimal()!!))
    ro third = br(1, 3).to_bigdecimal(MathContext.new(4, HalfEven))
    assert(third.equal("0.3333".to_bigdecimal()!!))
    ro two_thirds = br(2, 3).to_bigdecimal(MathContext.new(10, HalfEven))
    assert(two_thirds.equal("0.6666666667".to_bigdecimal()!!))
}

test "Ф.4: BigFloat @to_bigrat — точная конверсия" {
    ro a = BigFloat.new((3).to_bigint(), 1).to_bigrat()
    assert(a.equal(br(6, 1)))
    ro b = BigFloat.new((1).to_bigint(), -2).to_bigrat()
    assert(b.equal(br(1, 4)))
    ro c = BigFloat.new((-3).to_bigint(), 1).to_bigrat()
    assert(c.equal(br(-6, 1)))
    ro d = BigFloat.new((5).to_bigint(), -1).to_bigrat()
    assert(d.equal(br(5, 2)))
    ro z = BigFloat.new((0).to_bigint(), 99).to_bigrat()
    assert(z.is_zero())
}

// ──────────────────────────────────────────────────────────────────────────
// Ф.5: property-тесты (splitmix64, seed фиксирован), нормальная форма,
// канонические вектора, эталон-кейсы семьи (BigRat как точный эталон)
// ──────────────────────────────────────────────────────────────────────────

// splitmix64 — тот же public-domain PRNG, что в std.testing.handlers и в
// bigdecimal_test/bigfloat_test; реализован ЛОКАЛЬНО (прецедент пакета).
fn splitmix64_step(seed u64) -> u64 {
    mut z = seed.wrapping_add(0x9E3779B97F4A7C15)
    z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9)
    z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB)
    z ^ (z >> 31)
}

/// int в диапазоне [lo, hi] (включительно) из PRNG-состояния.
fn rand_range(state u64, lo int, hi int) -> int {
    ro span = (hi - lo + 1) as u64
    lo + (state % span) as int
}

fn sign_of(v int) -> int {
    if v < 0 { -1 } else if v > 0 { 1 } else { 0 }
}

/// Прямой assert нормальной формы BigRat: den > 0, gcd(|num|, den) == 1
/// (через BigInt @gcd), ноль = 0/1.
fn assert_normal(r BigRat) {
    assert(r.den().is_pos())
    ro g = r.num().abs().gcd(r.den())
    assert(g.is_one())
    if r.num().is_zero() { assert(r.den().is_one()) }
}

test "Ф.5: property — (a+b)-b == a, seed=7, N=300 (малые значения)" {
    mut state = splitmix64_step(7)
    for _ in 0..300 {
        ro p = rand_range(state, -1000, 1000); state = splitmix64_step(state)
        ro q = rand_range(state, 1, 1000); state = splitmix64_step(state)
        ro r = rand_range(state, -1000, 1000); state = splitmix64_step(state)
        ro s = rand_range(state, 1, 1000); state = splitmix64_step(state)
        ro a = br(p, q)
        ro b = br(r, s)
        assert(a.plus(b).minus(b).equal(a))
        assert(a.minus(b).plus(b).equal(a))
    }
}

test "Ф.5: property — (a/b)*b == a (b != 0), seed=13, N=300" {
    mut state = splitmix64_step(13)
    for _ in 0..300 {
        ro p = rand_range(state, -1000, 1000); state = splitmix64_step(state)
        ro q = rand_range(state, 1, 1000); state = splitmix64_step(state)
        ro rv = rand_range(state, -1000, 1000); state = splitmix64_step(state)
        ro r = if rv == 0 { 1 } else { rv }
        ro s = rand_range(state, 1, 1000); state = splitmix64_step(state)
        ro a = br(p, q)
        ro b = br(r, s)
        assert(a.div(b)!!.times(b).equal(a))
        assert(a.times(b).div(b)!!.equal(a))
    }
}

test "Ф.5: property — compare-транзитивность против int-эталона, seed=17, N=300" {
    mut state = splitmix64_step(17)
    for _ in 0..300 {
        ro x = rand_range(state, -100, 100); state = splitmix64_step(state)
        ro y = rand_range(state, -100, 100); state = splitmix64_step(state)
        ro z = rand_range(state, -100, 100); state = splitmix64_step(state)
        ro a = (x).to_bigrat()
        ro b = (y).to_bigrat()
        ro c = (z).to_bigrat()
        // compare == знаку int-разности — int-эталон
        assert(a.compare(b) == sign_of(x - y))
        assert(b.compare(a) == sign_of(y - x))
        // антисимметрия
        assert(a.compare(b) == -b.compare(a))
        // транзитивность строгого порядка
        if x < y && y < z { assert(a.compare(c) < 0) }
        if x > y && y > z { assert(a.compare(c) > 0) }
        // согласованность compare==0 с equal
        assert((a.compare(b) == 0) == a.equal(b))
    }
}

test "Ф.5: property — BigRat на целых == int-арифметика, seed=31, N=300" {
    mut state = splitmix64_step(31)
    for _ in 0..300 {
        ro n1 = rand_range(state, -1000000, 1000000); state = splitmix64_step(state)
        ro n2 = rand_range(state, -1000000, 1000000); state = splitmix64_step(state)
        ro a = (n1).to_bigrat()
        ro b = (n2).to_bigrat()
        assert(a.plus(b).equal((n1 + n2).to_bigrat()))
        assert(a.minus(b).equal((n1 - n2).to_bigrat()))
        assert(a.times(b).equal((n1 * n2).to_bigrat()))
        assert(a.neg().equal((-n1).to_bigrat()))
    }
}

test "Ф.5: нормальная форма после каждой op — den > 0, gcd == 1" {
    ro a = BigRat.new((4).to_bigint(), (8).to_bigint())!!
    assert_normal(a)
    ro b = br(3, 7)
    assert_normal(b)
    assert_normal(a.plus(b))
    assert_normal(a.minus(b))
    assert_normal(a.times(b))
    assert_normal(a.div(b)!!)
    assert_normal(br(2, 3).recip()!!)
    assert_normal(br(-2, 4).neg())
    assert_normal(br(-3, 6).abs())
    assert_normal(BigRat.zero())
    // гармоническая цепочка из 50 сложений: num/den растут, форма держится
    mut h = BigRat.zero()
    for i in 1..51 {
        h = h.plus(br(1, i))
        assert_normal(h)
    }
    assert(!h.is_int())
}

test "Ф.5: канонические вектора — 1/3+1/6 == 1/2, H_10 == 7381/2520" {
    ro s = br(1, 3).plus(br(1, 6))
    assert(s.equal(br(1, 2)))
    assert_normal(s)
    mut h = BigRat.zero()
    for i in 1..11 {
        h = h.plus(br(1, i))
    }
    assert(h.equal(BigRat.new((7381).to_bigint(), (2520).to_bigint())!!))
    assert(h.num().equal((7381).to_bigint()))
    assert(h.den().equal((2520).to_bigint()))
}

test "Ф.5: BigDecimal roundtrip — 1.25 ↔ 5/4 в обе стороны" {
    ro r = "1.25".to_bigdecimal()!!.to_bigrat()
    assert(r.equal(br(5, 4)))
    assert(r.to_str() == "5/4")
    ro d = br(5, 4).to_bigdecimal(MathContext.new(10, HalfEven))
    assert(d.equal("1.25".to_bigdecimal()!!))
}

// ──────────────────────────────────────────────────────────────────────────
// Эталон-кейсы мотива (тест-синергия семьи): ручное округление ТОЧНОГО
// BigRat-частного против округлённого деления BigDecimal/BigFloat.
// Расхождение = баг одного из двух. Ручное округление — независимая
// реализация (никакого кода библиотеки, кроме BigInt).
// ──────────────────────────────────────────────────────────────────────────

/// floor(log10(N/D)) для N > 0, D > 0 — позиция ведущей десятичной цифры.
fn rat_dec_exp(num BigInt, den BigInt) -> int {
    if num.compare(den) >= 0 {
        ro q = num.div(den) ?? panic("rat_dec_exp: den != 0")
        q.digits() - 1
    } else {
        mut p10 = BigInt.one()
        mut j = 0
        while num.times(p10).compare(den) < 0 {
            p10 = p10.times((10).to_bigint())
            j += 1
        }
        -j
    }
}

/// Ручное округление точной дроби q до p значащих десятичных цифр, HalfEven.
/// Значение = mant × 10^{-t}.
fn manual_round_half_even_dec(q BigRat, p int) -> BigDecimal {
    ro neg = q.sign() == Neg
    ro n = q.num().abs()
    ro d = q.den()
    if n.is_zero() { return BigDecimal.new(BigInt.zero(), 0) }
    ro e = rat_dec_exp(n, d)
    ro t = p - 1 - e
    ro p10 = (10).to_bigint()
    ro (num, den) = if t >= 0 {
        (n.times(p10.pow(t as uint)), d)
    } else {
        (n, d.times(p10.pow((-t) as uint)))
    }
    ro (qq, r) = num.div_rem(den) ?? panic("manual_round_dec: den != 0")
    ro two_r = r.plus(r)
    ro cmp = two_r.compare(den)
    ro carry = cmp > 0 || (cmp == 0 && !qq.is_even())
    ro m = if carry { qq.plus(BigInt.one()) } else { qq }
    ro mant = if neg { m.neg() } else { m }
    BigDecimal.new(mant, t)
}

/// floor(log2(N/D)) для N > 0, D > 0 — позиция ведущего бита.
fn rat_bit_exp(num BigInt, den BigInt) -> int {
    if num.compare(den) >= 0 {
        ro q = num.div(den) ?? panic("rat_bit_exp: den != 0")
        q.bit_length() - 1
    } else {
        mut pow2 = BigInt.one()
        mut j = 0
        while num.times(pow2).compare(den) < 0 {
            pow2 = pow2.shl(1)
            j += 1
        }
        -j
    }
}

/// Ручное округление точной дроби q до prec значащих БИТ, HalfEven.
/// Значение = mant × 2^{exp}.
fn manual_round_half_even_bin(q BigRat, prec int) -> BigFloat {
    ro neg = q.sign() == Neg
    ro n = q.num().abs()
    ro d = q.den()
    if n.is_zero() { return BigFloat.zero() }
    ro e = rat_bit_exp(n, d)
    ro t = prec - 1 - e
    ro (num, den) = if t >= 0 {
        (n.shl(t), d)
    } else {
        (n, d.shl(-t))
    }
    ro (qq, r) = num.div_rem(den) ?? panic("manual_round_bin: den != 0")
    ro two_r = r.plus(r)
    ro cmp = two_r.compare(den)
    ro carry = cmp > 0 || (cmp == 0 && !qq.is_even())
    ro m = if carry { qq.plus(BigInt.one()) } else { qq }
    ro mant = if neg { m.neg() } else { m }
    BigFloat.new(mant, -t)
}

fn check_bd_div_ref(a_s str, b_s str, p int) {
    ro a = a_s.to_bigdecimal()!!
    ro b = b_s.to_bigdecimal()!!
    ro q = a.to_bigrat().div(b.to_bigrat())!!
    ro expect = manual_round_half_even_dec(q, p)
    ro got = a.div(b, MathContext.new(p, HalfEven))
    assert(got.equal(expect))
}

test "Ф.5: эталон — BigDecimal @div(HalfEven) == ручное округление точного BigRat-частного" {
    check_bd_div_ref("1", "3", 1)
    check_bd_div_ref("1", "3", 10)
    check_bd_div_ref("19.99", "3", 4)
    check_bd_div_ref("100", "7", 5)
    check_bd_div_ref("0.001", "0.0003", 7)
    check_bd_div_ref("-5.5", "1.1", 3)
    check_bd_div_ref("123456789.123456", "0.0000001", 12)
    check_bd_div_ref("99999999999999999999", "100000000000000000001", 10)
}

fn check_bf_div_ref(am int, ae int, bm int, be int, prec int) {
    ro a = BigFloat.new((am).to_bigint(), ae)
    ro b = BigFloat.new((bm).to_bigint(), be)
    ro q = a.to_bigrat().div(b.to_bigrat())!!
    ro expect = manual_round_half_even_bin(q, prec)
    ro got = a.div(b, PrecisionContext.new(prec, HalfEven))
    assert(got.equal(expect))
}

test "Ф.5: эталон — BigFloat @div == ручное округление точного BigRat-частного (to_bigrat обеих сторон)" {
    check_bf_div_ref(3, 0, 2, 0, 8)
    check_bf_div_ref(1, 0, 2, 0, 2)
    check_bf_div_ref(3, -3, 1, -2, 8)
    check_bf_div_ref(5, -1, 1, -3, 8)
    check_bf_div_ref(-6, 0, 3, 0, 8)
    check_bf_div_ref(1, 0, 16, 0, 4)
    check_bf_div_ref(1, 0, 3, 0, 8)
    check_bf_div_ref(-7, -1, 11, 0, 16)
    check_bf_div_ref(1, -5, 7, 2, 24)
}

module bignum.repro_parse_test

import bignum.bigrat.{BigRat}
import bignum.bigfloat.{BigFloat}
import bignum.{ParseNumberError}

fn parse(s str) -> Result[BigRat, ParseNumberError] {
    ro n = s.to_bigint()
    match n {
        Ok(v) => Ok(BigRat.new(v, BigRat.one().den())!!)
        Err(e) => Err(e)
    }
}

test "repro: nested Err(OnlySign) pattern on ParseNumberError" {
    match parse("-") {
        Err(OnlySign) => assert(true)
        _ => assert(false)
    }
}

test "repro: nested Err(InvalidCharacter) pattern on ParseNumberError" {
    match parse("a") {
        Err(InvalidCharacter) => assert(true)
        _ => assert(false)
    }
}

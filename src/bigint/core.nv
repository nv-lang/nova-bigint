// Целые произвольной точности (BigInt).
// Представление: именованный кортеж (D215) со знаком (Sign-enum) и limbs []u32
// (little-endian, без ведущих нулей).
// Ноль = Zero + пустые limbs (каноничен, единственное представление).

module bignum.bigint

import std.math.int128.{i128}
import std.prelude.core.{Option, Some, None, Result, Ok, Err}
import std.runtime.string_builder.{StringBuilder}
import bignum.{Sign, Neg, Zero, Pos, ParseNumberError, Empty, OnlySign, InvalidCharacter}

// ──────────────────────────────────────────────────────────────────────────
// Типы
// ──────────────────────────────────────────────────────────────────────────

/// Ошибка деления на ноль.
#stable(since = "0.1")
export type DivError enum DivisionByZero

/// Arbitrary-precision signed integer.
///
/// Named tuple: copy = Sign tag + slice header (~24 bytes, stack-allocated).
/// Limb data lives on the GC heap and is shared on copy. All operations
/// return a normalized result.
#stable(since = "0.1")
export type BigInt(sign Sign, limbs []u32)

/// Ноль.
#stable(since = "0.1")
export fn BigInt.zero() -> BigInt => BigInt(Zero, []u32.new())

/// Единица.
#stable(since = "0.1")
export fn BigInt.one() -> BigInt => BigInt(Pos, []u32.of(1))

// ──────────────────────────────────────────────────────────────────────────
// Приватные хелперы
// ──────────────────────────────────────────────────────────────────────────

fn normalize(mut limbs []u32) -> () {
    while limbs.last() == Some(0) {
        limbs.pop()
    }
}

fn limb_add(a []u32, b []u32) -> []u32 {
    ro n = a.len().max(b.len())
    mut result = []u32.new()
    mut carry = 0 as u64
    for i in 0..n {
        ro av = if i < a.len() { a[i] as u64 } else { 0 as u64 }
        ro bv = if i < b.len() { b[i] as u64 } else { 0 as u64 }
        ro s = av + bv + carry
        result.push(s as u32)   // narrowing as = wraparound (D54) — маска излишня
        carry = s >> 32
    }
    if carry != 0 { result.push(carry as u32) }
    result
}

fn limb_sub(a []u32, b []u32) -> []u32 {
    if a.len() == 0 { return []u32.new() }
    mut result = []u32.new()
    mut borrow = 0 as u64
    for i in 0..a.len() {
        ro av = a[i] as u64
        ro bv = if i < b.len() { b[i] as u64 } else { 0 as u64 }
        ro subtrahend = bv + borrow
        if av >= subtrahend {
            result.push((av - subtrahend) as u32)
            borrow = 0
        } else {
            result.push((av + 0x100000000 - subtrahend) as u32)
            borrow = 1
        }
    }
    normalize(result)
    result
}

fn limb_compare(a []u32, b []u32) -> int {
    if a.len() != b.len() {
        if a.len() > b.len() { 1 } else { -1 }
    } else {
        mut res = 0
        mut i = a.len()
        while i > 0 && res == 0 {
            i -= 1
            if a[i] > b[i] { res = 1 }
            else if a[i] < b[i] { res = -1 }
        }
        res
    }
}

fn sign_mul(a Sign, b Sign) -> Sign {
    match (a, b) {
        (Zero, _) => Zero
        (_, Zero) => Zero
        (Pos, Pos) => Pos
        (Neg, Neg) => Pos
        (Neg, Pos) => Neg
        (Pos, Neg) => Neg
    }
}

fn sign_neg(s Sign) -> Sign {
    match s {
        Pos => Neg
        Neg => Pos
        Zero => Zero
    }
}

/// 10^9 для строковых конверсий.
const POW_10_9 u64 = 1000000000

// ──────────────────────────────────────────────────────────────────────────
// Умножение (школьное O(n²) + Карацуба O(n^log₂3))
// ──────────────────────────────────────────────────────────────────────────

fn school_mul(a []u32, b []u32) -> []u32 {
    if a.len() == 0 || b.len() == 0 { return []u32.new() }
    mut result = []u32.new().append_zero(a.len() + b.len())
    for i in 0..a.len() {
        ro ai = a[i] as u64
        if ai == 0 { continue }
        mut carry = 0 as u64
        for j in 0..b.len() {
            ro k = i + j
            ro cur = result[k] as u64 + ai * (b[j] as u64) + carry
            result[k] = cur as u32
            carry = cur >> 32
        }
        result[i + b.len()] = carry as u32
    }
    normalize(result)
    result
}

fn add_shifted(a []u32, b []u32, shift int) -> []u32 {
    ro max_len = a.len().max(b.len() + shift)
    mut result = a.clone().append_zero(max_len - a.len())
    mut carry = 0 as u64
    for i in 0..b.len() {
        ro k = shift + i
        ro s = result[k] as u64 + b[i] as u64 + carry
        result[k] = s as u32
        carry = s >> 32
    }
    if carry != 0 {
        for i in (shift + b.len())..max_len {
            ro s = result[i] as u64 + carry
            result[i] = s as u32
            carry = s >> 32
            if carry == 0 { break }
        }
        if carry != 0 { result.push(carry as u32) }
    }
    normalize(result)
    result
}

const KARATSUBA_THRESHOLD = 16

fn karatsuba_mul(a []u32, b []u32) -> []u32 {
    ro n = a.len().max(b.len())
    if n < KARATSUBA_THRESHOLD { return school_mul(a, b) }
    ro m = n / 2
    ro a_lo = a[..m.min(a.len())]
    ro a_hi = if m < a.len() { a[m..] } else { []u32.new() }
    ro b_lo = b[..m.min(b.len())]
    ro b_hi = if m < b.len() { b[m..] } else { []u32.new() }
    ro z0 = karatsuba_mul(a_lo, b_lo)
    ro z2 = karatsuba_mul(a_hi, b_hi)
    ro a_sum = limb_add(a_lo, a_hi)
    ro b_sum = limb_add(b_lo, b_hi)
    ro z1_raw = karatsuba_mul(a_sum, b_sum)
    ro z1_mid = limb_sub(z1_raw, z0)
    ro z1 = limb_sub(z1_mid, z2)
    ro r0 = z0
    ro r1 = add_shifted(r0, z1, m)
    ro result = add_shifted(r1, z2, 2 * m)
    result
}

fn mul_limbs(a []u32, b []u32) -> []u32 => karatsuba_mul(a, b)

// ──────────────────────────────────────────────────────────────────────────
// Деление (Кнут D, TAOCP §4.3.1)
// ──────────────────────────────────────────────────────────────────────────

fn div_step(mut u []u32, v []u32, q_hat u64, j int, n int) -> bool {
    mut borrow = 0 as u64
    for i in 0..n {
        ro prod = q_hat * (v[i] as u64)
        ro lo = prod & 0xFFFFFFFF
        ro hi = prod >> 32
        ro sub = lo + borrow
        ro uv = u[j + i] as u64
        if uv >= sub {
            u[j + i] = (uv - sub) as u32
            borrow = hi
        } else {
            u[j + i] = (uv + 0x100000000 - sub) as u32
            borrow = hi + 1
        }
    }
    if u[j + n] as u64 >= borrow {
        u[j + n] = (u[j + n] as u64 - borrow) as u32
        false
    } else {
        u[j + n] = (u[j + n] as u64 + 0x100000000 - borrow) as u32
        true
    }
}

fn add_back(mut u []u32, v []u32, j int, n int) {
    mut carry = 0 as u64
    for i in 0..n {
        ro s = (u[j + i] as u64) + (v[i] as u64) + carry
        u[j + i] = s as u32
        carry = s >> 32
    }
    u[j + n] = (u[j + n] as u64 + carry) as u32
}

// Сдвиг для нормализации делителя (чтобы старший лимб >= 2^31).
fn norm_shift(x u32) -> int {
    mut s = 0
    mut v = x as u64
    while v < (0x80000000 as u64) {
        v = v * 2
        s += 1
    }
    s
}

fn div_rem_limbs(a []u32, b []u32) -> ([]u32, []u32) {
    if limb_compare(a, b) < 0 {
        return ([]u32.new(), a.clone())
    }
    ro n = b.len()
    if n == 1 {
        ro d = b[0] as u64
        ro na = a.len()
        mut q = []u32.new()
        q.resize(na, 0 as u32)
        mut rem = 0 as u64
        mut i = na
        while i > 0 {
            i -= 1
            ro cur = (rem << 32) | (a[i] as u64)
            q[i] = (cur / d) as u32
            rem = cur % d
        }
        normalize(q)
        mut r = []u32.new()
        if rem != 0 { r.push(rem as u32) }
        return (q, r)
    }
    ro shift = norm_shift(b[n - 1])
    ro d = (1 as u64) << shift
    mut u_norm = []u32.new()
    mut carry = 0 as u64
    for i in 0..a.len() {
        ro prod = (a[i] as u64) * d + carry
        u_norm.push(prod as u32)
        carry = prod >> 32
    }
    u_norm.push(carry as u32)   // Кнут D1: u — ВСЕГДА ровно na+1 лимбов (carry может быть 0);
                                 // прежний двойной push (carry + безусловный 0) давал лишний лимб
    mut v_norm = []u32.new()
    carry = 0 as u64
    for i in 0..n {
        ro prod = (b[i] as u64) * d + carry
        v_norm.push(prod as u32)
        carry = prod >> 32
    }
    ro vn = v_norm.len()
    ro un = u_norm.len()
    ro mn = un - vn - 1
    ro v_hi = v_norm[vn - 1] as u64
    ro v_lo = if vn > 1 { v_norm[vn - 2] as u64 } else { 0 as u64 }
    mut q = []u32.new().append_zero(mn + 1)
    // Кнут D2/D7: j идёт от СТАРШЕГО сегмента ВНИЗ (фикс 2026-07-30: прежний
    // `for j in 0..mn+1` шёл снизу вверх — длинное деление так не работает,
    // q_hat младших сегментов вычислялся до вычитания старших кратных; не
    // ловилось тестами — все делители были однолимбовые, short-path n==1)
    mut j = mn
    while j >= 0 {
        ro idx = j
        ro u_hi = (u_norm[idx + vn] as u64) << 32 | (u_norm[idx + vn - 1] as u64)
        mut q_hat = u_hi / v_hi
        mut r_hat = u_hi % v_hi
        while q_hat >= 4294967296 || q_hat * v_lo > (r_hat << 32) + (if idx + vn >= 2 { u_norm[idx + vn - 2] as u64 } else { 0 }) {
            q_hat -= 1
            r_hat += v_hi
            if r_hat >= 4294967296 { break }
        }
        ro need_correction = div_step(u_norm, v_norm, q_hat, idx, vn)
        if need_correction {
            add_back(u_norm, v_norm, idx, vn)
            q_hat -= 1
        }
        q[idx] = q_hat as u32
        j -= 1
    }
    normalize(q)
    // Денормализация остатка
    mut r = []u32.new()
    carry = 0 as u64
    mut i = vn
    while i > 0 {
        i -= 1
        ro cur = (carry << 32) | (u_norm[i] as u64)
        r.push((cur / d) as u32)
        carry = cur % d
    }
    // Денормализация шла от старших лимбов — r собран big-endian; разворот в канон
    // little-endian. (Фикс 2026-07-30: прежний код строил r_rev, но строка `(q, r_rev)`
    // ОТБРАСЫВАЛАСЬ выражением-статментом, и возвращался неразвёрнутый r.)
    r.reverse()
    normalize(r)
    (q, r)
}

// ──────────────────────────────────────────────────────────────────────────
// Предикаты
// ──────────────────────────────────────────────────────────────────────────

/// Значение равно нулю.
#stable(since = "0.1")
export fn BigInt @is_zero() -> bool {
    match @sign { Zero => true; _ => false }
}

/// Значение отрицательно.
#stable(since = "0.1")
export fn BigInt @is_neg() -> bool {
    match @sign { Neg => true; _ => false }
}

/// Whether the value is positive.
#stable(since = "0.1")
export fn BigInt @is_pos() -> bool {
    match @sign { Pos => true; _ => false }
}

/// Значение равно единице.
#stable(since = "0.1")
export fn BigInt @is_one() -> bool {
    match @sign {
        Pos => @limbs.len() == 1 && @limbs[0] == 1
        _ => false
    }
}

/// Знак числа.
#stable(since = "0.1")
export fn BigInt @sign() -> Sign => @sign

// ──────────────────────────────────────────────────────────────────────────
// Сравнение
// ──────────────────────────────────────────────────────────────────────────

/// Равенство. `!=` выводится автоматически.
#stable(since = "0.1")
export fn BigInt @equal(other BigInt) -> bool {
    match (@sign, other.sign) {
        (Zero, Zero) => true
        (Neg, Neg) | (Pos, Pos) => limb_compare(@limbs, other.limbs) == 0
        _ => false
    }
}

/// Полное знаковое сравнение: -1 / 0 / 1.
#stable(since = "0.1")
export fn BigInt @compare(other BigInt) -> int {
    match (@sign, other.sign) {
        (Neg, Neg) => -limb_compare(@limbs, other.limbs)
        (Pos, Pos) => limb_compare(@limbs, other.limbs)
        (Zero, Zero) => 0
        (Neg, _) => -1
        (Pos, _) => 1
        (Zero, Neg) => 1
        (Zero, Pos) => -1
    }
}

// ──────────────────────────────────────────────────────────────────────────
// Конверсии (на источнике — nv-coding-style §1а)
// ──────────────────────────────────────────────────────────────────────────

/// Любой примитивный целый тип (`Ints`) → `BigInt`.
#stable(since = "0.1")
export fn[T Ints] T @to_bigint() -> BigInt {
    if @ == (0 as T) { return BigInt.zero() }
    ro v = @ as u64
    ro negative = @ < (0 as T)
    ro mag = if negative { (0 as u64).wrapping_sub(v) } else { v }
    ro lo = mag as u32
    ro hi = (mag >> 32) as u32
    mut limbs = []u32.new()
    limbs.push(lo)
    if hi != 0 { limbs.push(hi) }
    BigInt(if negative { Neg } else { Pos }, limbs)
}

/// `i128` → `BigInt`.
#stable(since = "0.1")
export fn i128 @to_bigint() -> BigInt {
    if @is_zero() { return BigInt.zero() }
    ro negative = @is_neg()
    ro (m_lo, m_hi) = if negative {
        if @ == i128((0x8000000000000000 as u64) as i64, 0) {
            (0 as u64, 0x8000000000000000 as u64)
        } else {
            ro abs_val = -@
            (abs_val.lo, abs_val.hi as u64)
        }
    } else {
        (@lo, @hi as u64)
    }
    mut limbs = []u32.new()
    limbs.push(m_lo as u32)
    limbs.push((m_lo >> 32) as u32)
    limbs.push(m_hi as u32)
    limbs.push((m_hi >> 32) as u32)
    normalize(limbs)
    BigInt(if negative { Neg } else { Pos }, limbs)
}

/// Десятичная строка → `Result[BigInt, ParseNumberError]`.
#stable(since = "0.1")
export fn str @to_bigint() -> Result[BigInt, ParseNumberError] {
    ro len = @len()
    if len == 0 { return Err(Empty) }
    ro bytes = @bytes()
    mut start = 0
    ro negative = if bytes[0] == ('-' as u8) {
        start = 1
        if len == 1 { return Err(OnlySign) }
        true
    } else {
        if bytes[0] == ('+' as u8) {
            start = 1
            if len == 1 { return Err(OnlySign) }
        }
        false
    }
    while start < len && bytes[start] == ('0' as u8) {
        start += 1
    }
    if start >= len { return Ok(BigInt.zero()) }
    ro remaining = len - start
    ro first_len = remaining % 9
    ro real_first = if first_len == 0 { 9 } else { first_len }
    mut result = BigInt.zero()
    mut pos = start
    if real_first > 0 {
        mut chunk_val = 0 as u64
        for i in 0..real_first {
            ro b = bytes[pos + i]
            if b < ('0' as u8) || b > ('9' as u8) { return Err(InvalidCharacter) }
            chunk_val = chunk_val * 10 + (b - ('0' as u8)) as u64
        }
        result = BigInt.new_raw(Pos, []u32.of(chunk_val as u32))
        pos += real_first
    }
    while pos < len {
        mut chunk_val = 0 as u64
        for i in 0..9 {
            ro b = bytes[pos + i]
            if b < ('0' as u8) || b > ('9' as u8) { return Err(InvalidCharacter) }
            chunk_val = chunk_val * 10 + (b - ('0' as u8)) as u64
        }
        result = mul_limb_small(result.limbs, POW_10_9) + BigInt.new_raw(Pos, []u32.of(chunk_val as u32))
        pos += 9
    }
    if negative { result = -result }
    Ok(result)
}

// Приватный конструктор для внутреннего использования.
fn BigInt.new_raw(s Sign, limbs []u32) -> BigInt => BigInt(s, limbs)

fn mul_limb_small(a []u32, b u64) -> BigInt {
    if a.len() == 0 || b == 0 { return BigInt.zero() }
    mut result = []u32.new()
    mut carry = 0 as u64
    for i in 0..a.len() {
        ro prod = (a[i] as u64) * b + carry
        result.push(prod as u32)
        carry = prod >> 32
    }
    if carry != 0 { result.push(carry as u32) }
    BigInt(Pos, result)
}

/// В `int`, если значение помещается; иначе `None`.
#stable(since = "0.1")
export fn BigInt @to_int() -> Option[int] {
    if @is_zero() { return Some(0) }
    if @limbs.len() > 2 { return None }
    ro lo = @limbs[0] as u64
    ro hi = if @limbs.len() > 1 { @limbs[1] as u64 } else { 0 as u64 }
    ro mag = (hi << 32) | lo
    match @sign {
        Pos => {
            if mag <= 9223372036854775807 as u64 {
                Some(mag as int)
            } else { None }
        }
        Neg => {
            if mag <= 9223372036854775808 as u64 {
                Some(-(mag as int))
            } else { None }
        }
        Zero => Some(0)
    }
}

/// В `i128`, если значение помещается; иначе `None`.
#stable(since = "0.1")
export fn BigInt @to_i128() -> Option[i128] {
    if @is_zero() { return Some(i128()) }
    if @limbs.len() > 4 { return None }
    ro l0 = @limbs[0] as u64
    ro l1 = if @limbs.len() > 1 { @limbs[1] as u64 } else { 0 as u64 }
    ro l2 = if @limbs.len() > 2 { @limbs[2] as u64 } else { 0 as u64 }
    ro l3 = if @limbs.len() > 3 { @limbs[3] as u64 } else { 0 as u64 }
    ro lo = l0 | (l1 << 32)
    ro hi = l2 | (l3 << 32)
    ro v = i128(hi as i64, lo)
    match @sign {
        Pos => {
            if @limbs.len() < 4 || (@limbs[3] as u32) <= 0x7FFFFFFF {
                Some(v)
            } else { None }
        }
        Neg => {
            if @limbs.len() < 4 || (@limbs[3] as u32) <= 0x80000000 {
                if lo == 0 && hi == 0x8000000000000000 as u64 {
                    Some(i128((0x8000000000000000 as u64) as i64, 0))
                } else if hi < 0x8000000000000000 as u64 {
                    Some(-v)
                } else { None }
            } else { None }
        }
        Zero => Some(i128())
    }
}

/// Десятичная запись числа.
#stable(since = "0.1")
export fn BigInt @to_str() -> str {
    if @is_zero() { return "0" }
    ro table = "0123456789".bytes()
    mut limbs = @limbs.clone()
    mut digits = []u8.new()
    while limbs.len() > 0 {
        ro (q, r_limbs) = div_rem_limbs(limbs, []u32.of(POW_10_9 as u32))
        mut rem_val = if r_limbs.len() > 0 { r_limbs[0] as u64 } else { 0 as u64 }
        if r_limbs.len() > 1 { rem_val = rem_val | ((r_limbs[1] as u64) << 32) }
        // Всегда извлекаем ровно 9 цифр (с ведущими нулями)
        for _ in 0..9 {
            digits.push(table[(rem_val % 10) as int])
            rem_val = rem_val / 10
        }
        limbs = q
    }
    digits.reverse()
    while digits.len() > 1 && digits[0] == ('0' as u8) {
        digits.remove(0)
    }
    consume sb = StringBuilder.new()
    match @sign { Neg => { sb.append("-") }; _ => {} }
    sb.append(digits)
    sb   // голое значение коэрсится в str (#coerce finalize, D429 R9) — явный into_str избыточен
}

// ──────────────────────────────────────────────────────────────────────────
// Арифметика
// ──────────────────────────────────────────────────────────────────────────

/// `a + b`. Оператор `+`.
#stable(since = "0.1")
export fn BigInt @plus(other BigInt) -> BigInt {
    if @is_zero() { return BigInt(other.sign, other.limbs.clone()) }
    if other.is_zero() { return BigInt(@sign, @limbs.clone()) }
    match (@sign, other.sign) {
        (Pos, Pos) | (Neg, Neg) => {
            BigInt(@sign, limb_add(@limbs, other.limbs))
        }
        _ => {
            ro cmp = limb_compare(@limbs, other.limbs)
            if cmp == 0 { BigInt.zero() }
            else if cmp > 0 {
                BigInt(@sign, limb_sub(@limbs, other.limbs))
            } else {
                BigInt(other.sign, limb_sub(other.limbs, @limbs))
            }
        }
    }
}

/// `a - b`. Оператор `-`.
#stable(since = "0.1")
export fn BigInt @minus(other BigInt) -> BigInt => @plus(-other)

/// `-a`. Оператор унарного минуса.
#stable(since = "0.1")
export fn BigInt @neg() -> BigInt {
    if @is_zero() { return @ }
    BigInt(sign_neg(@sign), @limbs.clone())
}

/// Абсолютная величина.
#stable(since = "0.1")
export fn BigInt @abs() -> BigInt {
    if @is_zero() { return @ }
    match @sign {
        Neg => BigInt(Pos, @limbs.clone())
        _ => @
    }
}

/// `a * b`. Оператор `*`.
#stable(since = "0.1")
export fn BigInt @times(other BigInt) -> BigInt {
    if @is_zero() || other.is_zero() { return BigInt.zero() }
    BigInt(sign_mul(@sign, other.sign), mul_limbs(@limbs, other.limbs))
}

/// `(a / b, a % b)` — деление с остатком.
/// Ошибка-значением (не panic) при делении на ноль.
#stable(since = "0.1")
export fn BigInt @div_rem(other BigInt) -> Result[(BigInt, BigInt), DivError] {
    if other.is_zero() { return Err(DivisionByZero) }
    if @is_zero() { return Ok((BigInt.zero(), BigInt.zero())) }
    ro cmp = limb_compare(@limbs, other.limbs)
    if cmp == 0 {
        ro q_sign = sign_mul(@sign, other.sign)
        ro q = BigInt.new_raw(q_sign, []u32.of(1))
        return Ok((q, BigInt.zero()))
    }
    if cmp < 0 {
        return Ok((BigInt.zero(), @))
    }

    ro (q_limbs, r_limbs) = div_rem_limbs(@limbs, other.limbs)
    ro q_sign = sign_mul(@sign, other.sign)
    ro r_sign = if r_limbs.len() == 0 { Zero } else { @sign }
    ro q = BigInt.new_raw(q_sign, q_limbs)
    ro r = BigInt.new_raw(r_sign, r_limbs)
    Ok((q, r))
}

/// `a / b` (trunc-к-нулю).
#stable(since = "0.1")
export fn BigInt @div(other BigInt) -> Result[BigInt, DivError] {
    ro dr = @div_rem(other)
    match dr {
        Ok((q, _)) => Ok(q)
        Err(e) => Err(e)
    }
}

/// `a % b` (остаток со знаком делимого).
#stable(since = "0.1")
export fn BigInt @rem(other BigInt) -> Result[BigInt, DivError] {
    ro dr = @div_rem(other)
    match dr {
        Ok((_, r)) => Ok(r)
        Err(e) => Err(e)
    }
}

/// Greatest common divisor (Euclidean algorithm over `@rem`).
/// The result is non-negative; `gcd(0, 0) == 0`.
#stable(since = "0.1")
export fn BigInt @gcd(other BigInt) -> BigInt {
    if @is_zero() && other.is_zero() { return BigInt.zero() }
    mut a = @abs()
    mut b = other.abs()
    while !b.is_zero() {
        ro r = a.rem(b) ?? panic("gcd: divisor b != 0 guaranteed by loop")
        a = b
        b = r
    }
    a
}

/// Количество десятичных цифр (V1: через to_str).
#stable(since = "0.1")
export fn BigInt @digits() -> int {
    if @is_zero() { return 1 }
    ro s = @to_str()
    if @is_neg() { s.byte_len() - 1 } else { s.byte_len() }
}

/// Number of significant bits of the absolute value (0 for zero).
/// V1: O(n) over limbs.
#stable(since = "0.1")
export fn BigInt @bit_length() -> int {
    if @is_zero() { return 0 }
    ro last = @limbs[@limbs.len() - 1] as u64
    ro bit_len = (@limbs.len() - 1) * 32
    mut v = last
    mut n = 0
    while v > 0 { v = v / 2; n += 1 }
    bit_len + n
}

/// Unsigned shift LEFT (multiplication by 2^{bits}). Sign is preserved.
#stable(since = "0.1")
export fn BigInt @shl(bits int) -> BigInt {
    if bits == 0 || @is_zero() { return @ }
    ro words = bits / 32
    ro shift = bits % 32
    mut result = []u32.new()
    for _ in 0..words { result.push(0 as u32) }
    mut carry = 0 as u64
    for i in 0..@limbs.len() {
        ro v = (@limbs[i] as u64) << shift | carry
        result.push(v as u32)
        carry = v >> 32
    }
    if carry != 0 { result.push(carry as u32) }
    BigInt(@sign, result)
}

/// Unsigned shift RIGHT (trunc-toward-zero division by 2^{bits}). Sign is preserved.
/// For sign-magnitude BigInt, shifting the magnitude equals truncation.
#stable(since = "0.1")
export fn BigInt @shr(bits int) -> BigInt {
    if bits == 0 { return @ }
    if @is_zero() { return BigInt.zero() }
    ro words = bits / 32
    ro shift = bits % 32
    if words >= @limbs.len() { return BigInt.zero() }
    ro new_len = @limbs.len() - words
    mut result = []u32.new()
    if shift == 0 {
        for i in 0..new_len { result.push(@limbs[words + i]) }
    } else {
        ro inv = 32 - shift
        for i in 0..new_len {
            ro lo = @limbs[words + i] >> shift
            ro hi = if i + words + 1 < @limbs.len() { @limbs[words + i + 1] << inv } else { 0 as u32 }
            result.push(lo | hi)
        }
    }
    normalize(result)
    if result.len() == 0 { return BigInt.zero() }
    BigInt(@sign, result)
}

/// Чётное ли число (младший бит).
#stable(since = "0.1")
export fn BigInt @is_even() -> bool {
    if @is_zero() { return true }
    (@limbs[0] & 1) == 0
}

/// `a` в целой степени `n` (n ≥ 0). Бинарное возведение в степень.
#stable(since = "0.1")
export fn BigInt @pow(n int) -> BigInt
    requires n >= 0
{
    if n == 0 { return BigInt.one() }
    if @is_zero() { return BigInt.zero() }
    if @is_one() { return @ }
    mut base = @
    mut exp = n
    mut result = BigInt.one()
    while exp > 0 {
        if (exp & 1) != 0 {
            result = result * base
        }
        exp = exp >> 1
        if exp != 0 {
            base = base * base
        }
    }
    result
}


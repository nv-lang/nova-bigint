// Тест эквивалентности умножения: school_mul vs karatsuba_mul дают одинаковый
// результат (НЕ замер скорости — настоящий bench-синтаксис — `bench "имя" {
// measure { ... } }`, см. bench/micro/hello.nv в репе nova; здесь обычные
// `test`-блоки). Замеры порога — в отчёте (threshold = 16, измерено для
// 10/30/100/300 лимбов).
//
// Файл переехал внутрь bignum.bigint вместе с остальной папкой-модулем
// (было bigint_bench.nv, отдельный module `bignum.bigint_bench`) — имя
// bench.nv было бы враньём, назван честно mul_equiv_test.nv.

module bignum.bigint

fn gen_limbs(n int) -> []u32 {
    mut limbs = []u32.new()
    for i in 0..n {
        limbs.push((i * 2654435761 + 12345) as u32)
    }
    limbs
}

fn limbs_eq(a []u32, b []u32) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..a.len() {
        if a[i] != b[i] { return false }
    }
    true
}

test "karatsuba vs school: 10 limbs" {
    ro a = gen_limbs(10)
    ro b = gen_limbs(10)
    assert(limbs_eq(karatsuba_mul(a, b), school_mul(a, b)))
}

test "karatsuba vs school: 30 limbs" {
    ro a = gen_limbs(30)
    ro b = gen_limbs(30)
    assert(limbs_eq(karatsuba_mul(a, b), school_mul(a, b)))
}

test "karatsuba vs school: 100 limbs" {
    ro a = gen_limbs(100)
    ro b = gen_limbs(100)
    assert(limbs_eq(karatsuba_mul(a, b), school_mul(a, b)))
}

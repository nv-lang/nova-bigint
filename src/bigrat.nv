// Точные рациональные числа: num / den над BigInt.
// Поверх BigInt (bignum.nv, план 235). План: docs/plans/240-bigrat.md
// в репе nova. Своей арифметики лимбов нет — вся арифметика через BigInt.
//
// Value-record: копия = два BigInt (heap-указатели). Нормальная форма
// (инвариант КАЖДОЙ операции): den > 0 (знак живёт в num), gcd(|num|, den) == 1,
// канонический ноль = 0/1. Нормализация ЖАДНАЯ (в каждом конструкторе/операции) —
// в отличие от lazy-нормализации BigDecimal: для рациональных сокращение —
// защита от взрыва num/den по цепочке операций, не косметика.

module bignum.bigrat

import bignum.{BigInt, DivError, DivisionByZero, ParseNumberError, Sign, Neg, Zero, Pos, Empty, ZeroDenominator}
import bignum.bigdecimal.{BigDecimal, MathContext}
import std.prelude.core.{Option, Some, None, Result, Ok, Err}
import std.checksums.fnv.{Fnv}
import std.runtime.string_builder.{StringBuilder}

// ──────────────────────────────────────────────────────────────────────────
// Типы
// ──────────────────────────────────────────────────────────────────────────

/// Точное рациональное число: значение = `num / den`.
/// Инвариант нормальной формы (поддерживается каждой операцией):
/// `den > 0`, `gcd(|num|, den) == 1`, ноль = `0/1`.
#stable(since = "0.1")
export type BigRat value {
    num BigInt
    den BigInt
}

/// Ноль (каноничная форма: 0/1).
#stable(since = "0.1")
export fn BigRat.zero() -> BigRat => { num: BigInt.zero(), den: BigInt.one() }

/// Единица (1/1).
#stable(since = "0.1")
export fn BigRat.one() -> BigRat => { num: BigInt.one(), den: BigInt.one() }

/// Построить `BigRat` из числителя и знаменателя, приведя к нормальной форме.
/// `den == 0` → `Err(DivisionByZero)` (паритет `BigInt @div_rem`).
#stable(since = "0.1")
export fn BigRat.new(num BigInt, den BigInt) -> Result[BigRat, DivError] {
    if den.is_zero() { return Err(DivisionByZero) }
    Ok(normalize_rat(num, den))
}

// ──────────────────────────────────────────────────────────────────────────
// Приватные хелперы
// ──────────────────────────────────────────────────────────────────────────

/// Привести `(num, den)` к нормальной форме: den > 0, знак в num, ноль = 0/1,
/// gcd(|num|, den) == 1 (сокращение НОД — через `BigInt @gcd`, Ф.1).
/// Вызывающий гарантирует `den != 0`.
fn normalize_rat(num BigInt, den BigInt) -> BigRat {
    if num.is_zero() { return { num: BigInt.zero(), den: BigInt.one() } }
    ro n = if den.is_neg() { num.neg() } else { num }
    ro d = if den.is_neg() { den.neg() } else { den }
    ro g = n.abs().gcd(d)
    if g.is_one() {
        { num: n, den: d }
    } else {
        { num: n.div(g) ?? panic("normalize_rat: g != 0"), den: d.div(g) ?? panic("normalize_rat: g != 0") }
    }
}

// ──────────────────────────────────────────────────────────────────────────
// Предикаты
// ──────────────────────────────────────────────────────────────────────────

/// Whether the value is zero (canonical form: 0/1).
#stable(since = "0.1")
export fn BigRat @is_zero() -> bool => @num.is_zero()

/// Whether the value is an integer (den == 1 in normal form).
#stable(since = "0.1")
export fn BigRat @is_int() -> bool => @den.is_one()

/// Sign of the value. Denominator is positive, so the sign lives in the numerator.
#stable(since = "0.1")
export fn BigRat @sign() -> Sign {
    if @num.is_neg() { Neg } else if @num.is_zero() { Zero } else { Pos }
}

// ──────────────────────────────────────────────────────────────────────────
// Свойства (D84/D409, образец `BigDecimal @scale()`)
// ──────────────────────────────────────────────────────────────────────────

/// Числитель.
#stable(since = "0.1")
export fn BigRat @num() -> BigInt => @num

/// Знаменатель (всегда > 0 в нормальной форме).
#stable(since = "0.1")
export fn BigRat @den() -> BigInt => @den

// ──────────────────────────────────────────────────────────────────────────
// Равенство (нормальная форма делает покомпонентное сравнение корректным)
// ──────────────────────────────────────────────────────────────────────────

/// Равенство. `!=` выводится автоматически. Покомпонентное сравнение корректно
/// только благодаря нормальной форме (каноничность поддерживается каждой операцией).
#stable(since = "0.1")
export fn BigRat @equal(other BigRat) -> bool {
    @num.equal(other.num) && @den.equal(other.den)
}

/// Полное знаковое сравнение: -1 / 0 / 1. Кросс-умножение `num_a*den_b <=> num_b*den_a`
/// (den > 0 ⇒ знаки корректны, float не участвует).
#stable(since = "0.1")
export fn BigRat @compare(other BigRat) -> int {
    (@num * other.den).compare(other.num * @den)
}

/// Хэш, согласованный с `@equal` (нормальная форма ⇒ (num, den) уникальна).
#stable(since = "0.1")
export fn BigRat @hash() -> u64 {
    Fnv.hash_str(@num.to_str()) ^ Fnv.hash_str(@den.to_str())
}

// ──────────────────────────────────────────────────────────────────────────
// Конверсии (на источнике — nv-coding-style §1а)
// ──────────────────────────────────────────────────────────────────────────

/// Любой примитивный целый тип (`Ints`) → `BigRat` (n/1).
#stable(since = "0.1")
export fn[T Ints] T @to_bigrat() -> BigRat {
    ro bi = @to_bigint()
    if bi.is_zero() { BigRat.zero() } else { { num: bi, den: BigInt.one() } }
}

/// `i128` → `BigRat` (n/1). Явная перегрузка — `i128` не входит в `Ints`.
#stable(since = "0.1")
export fn i128 @to_bigrat() -> BigRat {
    ro bi = @to_bigint()
    if bi.is_zero() { BigRat.zero() } else { { num: bi, den: BigInt.one() } }
}

// ──────────────────────────────────────────────────────────────────────────
// Арифметика
// ──────────────────────────────────────────────────────────────────────────

/// `a + b`. Оператор `+` (desugar `@plus`, прецедент семьи).
/// `(a/b + c/d) = (a·d + c·b) / (b·d)`, затем нормальная форма.
#stable(since = "0.1")
export fn BigRat @plus(other BigRat) -> BigRat {
    ro n = @num * other.den + other.num * @den
    ro d = @den * other.den
    normalize_rat(n, d)
}

/// `a - b`. Оператор `-`.
#stable(since = "0.1")
export fn BigRat @minus(other BigRat) -> BigRat => @plus(other.neg())

/// `-a`.
#stable(since = "0.1")
export fn BigRat @neg() -> BigRat => { num: @num.neg(), @den }

/// Абсолютная величина.
#stable(since = "0.1")
export fn BigRat @abs() -> BigRat => { num: @num.abs(), @den }

/// `a * b`. Оператор `*`.
#stable(since = "0.1")
export fn BigRat @times(other BigRat) -> BigRat {
    normalize_rat(@num * other.num, @den * other.den)
}

/// `1 / a`. Ноль → `Err(DivisionByZero)`. Оператор `/` не десугарится —
/// Result-возврат (симметрия «`/` не оператор» у BigDecimal, D9).
#stable(since = "0.1")
export fn BigRat @recip() -> Result[BigRat, DivError] {
    if @num.is_zero() { return Err(DivisionByZero) }
    Ok(normalize_rat(@den, @num))
}

/// `a / b`. Ноль (b) → `Err(DivisionByZero)`. Оператор `/` не десугарится —
/// Result-возврат (симметрия «`/` не оператор» у BigDecimal, D9).
#stable(since = "0.1")
export fn BigRat @div(other BigRat) -> Result[BigRat, DivError] {
    if other.is_zero() { return Err(DivisionByZero) }
    Ok(normalize_rat(@num * other.den, @den * other.num))
}

// ──────────────────────────────────────────────────────────────────────────
// Строки (§2 плана 240)
// ──────────────────────────────────────────────────────────────────────────

/// Parse `"p/q"` or a plain integer `"n"` (sign lives on p). Delegates to
/// `str @to_bigint()` for both parts — same `ParseNumberError`, no adapter
/// needed; `den == 0` → `ZeroDenominator`.
#stable(since = "0.1")
export fn str @to_bigrat() -> Result[BigRat, ParseNumberError] {
    ro len = @byte_len()
    if len == 0 { return Err(Empty) }
    ro bytes = @bytes()
    mut slash = -1
    for i in 0..len {
        if bytes[i] == ('/' as u8) { slash = i; break }
    }
    if slash < 0 {
        ro n = @to_bigint()
        return match n {
            Ok(bi) => Ok(if bi.is_zero() { BigRat.zero() } else { { num: bi, den: BigInt.one() } })
            Err(e) => Err(e)
        }
    }
    consume num_sb = StringBuilder.new()
    num_sb.append(bytes[..slash])
    ro num_s = num_sb.into_str()
    consume den_sb = StringBuilder.new()
    den_sb.append(bytes[slash + 1..])
    ro den_s = den_sb.into_str()
    ro num = num_s.to_bigint()?
    ro den = den_s.to_bigint()?
    if den.is_zero() { return Err(ZeroDenominator) }
    Ok(normalize_rat(num, den))
}

/// `"p/q"`; целые (den == 1) — просто `"p"`.
#stable(since = "0.1")
export fn BigRat @to_str() -> str {
    if @den.is_one() { return @num.to_str() }
    consume sb = StringBuilder.new()
    sb.append(@num.to_str())
    sb.append("/")
    sb.append(@den.to_str())
    sb  // голое значение коэрсится в str (#coerce finalize, D429 R9) — явный into_str избыточен
}

/// В `int` trunc-к-нулю (паритет int-деления). `None` при переполнении приёмника.
#stable(since = "0.1")
export fn BigRat @to_int() -> Option[int] {
    ro q = @num.div(@den) ?? panic("to_int: den != 0 guaranteed by normal form")
    q.to_int()
}

/// В `i128` trunc-к-нулю (паритет int-деления). `None` при переполнении приёмника.
#stable(since = "0.1")
export fn BigRat @to_i128() -> Option[i128] {
    ro q = @num.div(@den) ?? panic("to_i128: den != 0 guaranteed by normal form")
    q.to_i128()
}

// ──────────────────────────────────────────────────────────────────────────
// Связка семьи (обе сестры — мотив «точный эталон» требует обеих)
// ──────────────────────────────────────────────────────────────────────────

/// `BigDecimal` → `BigRat` ТОЧНО: `mant / 10^{scale}` → нормальная форма.
/// Отрицательный scale (целое с неявными нулями) — умножение на `10^{|scale|}`.
#stable(since = "0.1")
export fn BigDecimal @to_bigrat() -> BigRat {
    if @mant.is_zero() { return BigRat.zero() }
    if @scale > 0 {
        normalize_rat(@mant, (10).to_bigint().pow(@scale as uint))
    } else if @scale < 0 {
        { num: @mant * (10).to_bigint().pow((-@scale) as uint), den: BigInt.one() }
    } else {
        { num: @mant, den: BigInt.one() }
    }
}

/// `BigRat` → `BigDecimal` делением `num/den` с округлением `mc` (первый носитель
/// «BigRat как эталон» в тестах 236). Делегируется `BigDecimal @div`.
#stable(since = "0.1")
export fn BigRat @to_bigdecimal(mc MathContext) -> BigDecimal {
    BigDecimal.new(@num, 0).div(BigDecimal.new(@den, 0), mc)
}

/// `BigFloat` → `BigRat` ТОЧНО: `mant × 2^{exp}`. exp ≥ 0 → `num = mant.shl(exp)`;
/// exp < 0 → `den = 1.shl(-exp)` (мантисса BigFloat нечётна → НОД с 2^k = 1).
#stable(since = "0.1")
export fn BigFloat @to_bigrat() -> BigRat {
    if @mant.is_zero() { return BigRat.zero() }
    if @exp >= 0 {
        { num: @mant.shl(@exp), den: BigInt.one() }
    } else {
        normalize_rat(@mant, BigInt.one().shl(-@exp))
    }
}

// Общее для всей bignum-семьи (BigInt/BigRat/BigDecimal/BigFloat): знак и
// единый тип ошибок разбора строк. Сами типы семьи — в своих модулях
// (bignum.bigint, bignum.bigrat, bignum.bigdecimal, bignum.bigfloat).

module bignum

// ──────────────────────────────────────────────────────────────────────────
// Типы
// ──────────────────────────────────────────────────────────────────────────

/// Знак числа.
#stable(since = "0.1")
export type Sign enum Neg | Zero | Pos

/// Error parsing a numeric string into any bignum family type (BigInt,
/// BigRat, BigDecimal, BigFloat) — one shared enum across the whole
/// parsing surface, no per-type variant or adapter (plan 243 Ф.U/У.1).
#stable(since = "0.1")
export type ParseNumberError enum
    | Empty
    | OnlySign
    | InvalidCharacter
    | MultiplePoints
    | MultipleExponents
    | EmptyExponent
    | EmptyMantissa
    | ZeroDenominator

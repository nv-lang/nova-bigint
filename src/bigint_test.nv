// Тесты bignum (BigInt) — целые произвольной точности.
// Ф.1: ядро — сложение/вычитание, сравнение, отрицание, конверсии.
// Ф.2: умножение, деление.
// Ф.3: строки.
// Ф.4: мутирующие операции.
// Ф.5: i128-конверсии, операторы.

module bignum.bigint_test

import std.math.int128.{i128}
import bignum.bigint.{BigInt}

// ── Константы и предикаты ──────────────────────────────────────────────────

test "zero/one constants" {
    ro z = BigInt.zero()
    assert(z.is_zero())
    ro zs = z.sign()
    match zs { Zero => assert(true); _ => assert(false) }

    ro o = BigInt.one()
    assert(!o.is_zero())
    ro os = o.sign()
    match os { Pos => assert(true); _ => assert(false) }
}

test "is_zero / is_neg / is_one" {
    assert(BigInt.zero().is_zero())
    assert(!BigInt.one().is_zero())
    assert(BigInt.one().is_one())
    assert(!BigInt.zero().is_one())
    assert(!BigInt.one().is_neg())
    assert(((-1).to_bigint()).is_neg())
}

test "sign" {
    ro zs = BigInt.zero().sign()
    match zs { Zero => assert(true); _ => assert(false) }
    ro ps = (42).to_bigint().sign()
    match ps { Pos => assert(true); _ => assert(false) }
    ro ns = (-42).to_bigint().sign()
    match ns { Neg => assert(true); _ => assert(false) }
}

// ── Конверсии ──────────────────────────────────────────────────────────────

test "to_bigint: i64" {
    assert((0).to_bigint().is_zero())
    assert((1).to_bigint() == BigInt.one())
    assert((-1).to_bigint() == -BigInt.one())
    ro a = (42).to_bigint()
    ro sa = a.sign()
    match sa { Pos => assert(true); _ => assert(false) }
    ro b = (-42).to_bigint()
    ro sb = b.sign()
    match sb { Neg => assert(true); _ => assert(false) }
}

test "to_bigint: u64" {
    ro v = (0xFFFFFFFFFFFFFFFF as u64).to_bigint()
    assert(!v.is_zero())
    ro vs = v.sign()
    match vs { Pos => assert(true); _ => assert(false) }
}

test "to_bigint: i128" {
    ro zi = i128()
    assert(zi.to_bigint().is_zero())
    ro oi = i128(0, 1)
    assert(oi.to_bigint() == BigInt.one())
    ro ni = -i128(0, 1)
    assert(ni.to_bigint() == -BigInt.one())
    ro maxi = i128(9223372036854775807, 0xFFFFFFFFFFFFFFFF)
    ro maxs = maxi.to_bigint().sign()
    match maxs { Pos => assert(true); _ => assert(false) }
    ro mini = i128((0x8000000000000000 as u64) as i64, 0)
    ro mins = mini.to_bigint().sign()
    match mins { Neg => assert(true); _ => assert(false) }
}

test "to_int: fits" {
    assert(BigInt.zero().to_int() == Some(0))
    assert(BigInt.one().to_int() == Some(1))
    assert((-BigInt.one()).to_int() == Some(-1))
    assert((1234567890).to_bigint().to_int() == Some(1234567890))
    assert((-1234567890).to_bigint().to_int() == Some(-1234567890))
}

test "to_int: overflow" {
    ro maxi = i128(9223372036854775807, 0xFFFFFFFFFFFFFFFF)
    assert(maxi.to_bigint().to_int() == None)
    ro mini = i128((0x8000000000000000 as u64) as i64, 0)
    assert(mini.to_bigint().to_int() == None)
}

// ── Сравнение ──────────────────────────────────────────────────────────────

test "equal" {
    assert(BigInt.zero() == BigInt.zero())
    assert(BigInt.one() == BigInt.one())
    assert(BigInt.one() != BigInt.zero())
    assert((-BigInt.one()) == -BigInt.one())
    assert((42).to_bigint() == (42).to_bigint())
    assert((42).to_bigint() != (43).to_bigint())
}

test "compare: sign" {
    assert(BigInt.one().compare(BigInt.zero()) > 0)
    assert(BigInt.zero().compare(BigInt.one()) < 0)
    assert((-BigInt.one()).compare(BigInt.zero()) < 0)
    assert(BigInt.zero().compare(-BigInt.one()) > 0)
    assert((-BigInt.one()).compare(BigInt.one()) < 0)
    assert(BigInt.one().compare(-BigInt.one()) > 0)
}

test "compare: magnitude" {
    ro a = (0xFFFFFFFF as u64).to_bigint()
    ro b = (0x100000000 as u64).to_bigint()
    assert(a.compare(b) < 0)
    assert(b.compare(a) > 0)
    assert((100).to_bigint().compare((50).to_bigint()) > 0)
    assert((50).to_bigint().compare((100).to_bigint()) < 0)
    assert((100).to_bigint().compare((100).to_bigint()) == 0)
}

test "compare: negative" {
    assert((-BigInt.one()).compare(-BigInt.one()) == 0)
    assert((-100).to_bigint().compare((-50).to_bigint()) < 0)
    assert((-50).to_bigint().compare((-100).to_bigint()) > 0)
}

test "operators < и >" {
    assert(BigInt.one() > BigInt.zero())
    assert(BigInt.zero() < BigInt.one())
    assert((-BigInt.one()) < BigInt.zero())
    assert((-BigInt.one()) < BigInt.one())
}

// ── Сложение ───────────────────────────────────────────────────────────────

test "plus: ноль" {
    assert(BigInt.zero() + BigInt.zero() == BigInt.zero())
    assert(BigInt.one() + BigInt.zero() == BigInt.one())
    assert(BigInt.zero() + BigInt.one() == BigInt.one())
}

test "plus: положительные" {
    assert((2).to_bigint() + (3).to_bigint() == (5).to_bigint())
    assert((100).to_bigint() + (200).to_bigint() == (300).to_bigint())
}

test "plus: отрицательные" {
    assert((-2).to_bigint() + (-3).to_bigint() == (-5).to_bigint())
    assert((-100).to_bigint() + (-200).to_bigint() == (-300).to_bigint())
}

test "plus: разные знаки" {
    assert((-5).to_bigint() + (3).to_bigint() == (-2).to_bigint())
    assert((5).to_bigint() + (-3).to_bigint() == (2).to_bigint())
    assert((-3).to_bigint() + (5).to_bigint() == (2).to_bigint())
    assert((3).to_bigint() + (-5).to_bigint() == (-2).to_bigint())
}

test "plus: противоположные числа" {
    assert((5).to_bigint() + (-5).to_bigint() == BigInt.zero())
    assert((-5).to_bigint() + (5).to_bigint() == BigInt.zero())
}

test "plus: перенос через лимб" {
    ro a = (0xFFFFFFFF as u64).to_bigint()
    ro b = (1 as u64).to_bigint()
    ro r = a + b
    assert(r == (0x100000000 as u64).to_bigint())
}

// ── Вычитание ──────────────────────────────────────────────────────────────

test "minus: ноль" {
    assert(BigInt.zero() - BigInt.zero() == BigInt.zero())
    assert((5).to_bigint() - BigInt.zero() == (5).to_bigint())
    assert(BigInt.zero() - (5).to_bigint() == (-5).to_bigint())
}

test "minus: положительные" {
    assert((10).to_bigint() - (3).to_bigint() == (7).to_bigint())
    assert((3).to_bigint() - (10).to_bigint() == (-7).to_bigint())
}

test "minus: отрицательные" {
    assert((-10).to_bigint() - (-3).to_bigint() == (-7).to_bigint())
    assert((-3).to_bigint() - (-10).to_bigint() == (7).to_bigint())
}

test "minus: заём через лимб" {
    ro a = (0x100000000 as u64).to_bigint()
    ro b = (1 as u64).to_bigint()
    ro r = a - b
    assert(r == (0xFFFFFFFF as u64).to_bigint())
}

// ── Отрицание и модуль ─────────────────────────────────────────────────────

test "neg" {
    assert(-BigInt.zero() == BigInt.zero())
    assert(-BigInt.one() == (-1).to_bigint())
    assert(-(-1).to_bigint() == BigInt.one())
    assert(-(42).to_bigint() == (-42).to_bigint())
}

test "abs" {
    assert(BigInt.zero().abs() == BigInt.zero())
    assert(BigInt.one().abs() == BigInt.one())
    assert((-BigInt.one()).abs() == BigInt.one())
    assert((42).to_bigint().abs() == (42).to_bigint())
    assert((-42).to_bigint().abs() == (42).to_bigint())
}

// ── Умножение ──────────────────────────────────────────────────────────────

test "mul: ноль" {
    assert(BigInt.zero() * BigInt.one() == BigInt.zero())
    assert(BigInt.one() * BigInt.zero() == BigInt.zero())
    assert(BigInt.zero() * BigInt.zero() == BigInt.zero())
}

test "mul: единица" {
    assert(BigInt.one() * BigInt.one() == BigInt.one())
    assert((42).to_bigint() * BigInt.one() == (42).to_bigint())
    assert(BigInt.one() * (42).to_bigint() == (42).to_bigint())
}

test "mul: положительные" {
    assert((6).to_bigint() * (7).to_bigint() == (42).to_bigint())
    assert((100).to_bigint() * (200).to_bigint() == (20000).to_bigint())
    assert((12345).to_bigint() * (6789).to_bigint() == (12345 * 6789).to_bigint())
}

test "mul: знаки" {
    assert((-6).to_bigint() * (7).to_bigint() == (-42).to_bigint())
    assert((6).to_bigint() * (-7).to_bigint() == (-42).to_bigint())
    assert((-6).to_bigint() * (-7).to_bigint() == (42).to_bigint())
}

test "mul: большой перенос" {
    ro a = (0xFFFFFFFF as u64).to_bigint()
    ro b = (0xFFFFFFFF as u64).to_bigint()
    ro expected = (0xFFFFFFFE00000001 as u64).to_bigint()
    assert(a * b == expected)
}

// ── Деление ────────────────────────────────────────────────────────────────

test "div_rem: ноль делимого" {
    ro dr = BigInt.zero().div_rem((5).to_bigint())
    match dr {
        Ok((q, r)) => {
            assert(q.is_zero())
            assert(r.is_zero())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: ноль делителя" {
    ro dr = (5).to_bigint().div_rem(BigInt.zero())
    match dr {
        Ok(_) => assert(false)
        Err(DivisionByZero) => assert(true)
        _ => assert(false)
    }
}

test "div_rem: a < b" {
    ro dr = (3).to_bigint().div_rem((10).to_bigint())
    match dr {
        Ok((q, r)) => {
            assert(q.is_zero())
            assert(r == (3).to_bigint())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: a == b" {
    ro dr = (7).to_bigint().div_rem((7).to_bigint())
    match dr {
        Ok((q, r)) => {
            assert(q == BigInt.one())
            assert(r.is_zero())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: простые" {
    ro dr = (100).to_bigint().div_rem((3).to_bigint())
    match dr {
        Ok((q, r)) => {
            assert(q == (33).to_bigint())
            assert(r == (1).to_bigint())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: знаки" {
    // trunc-к-нулю: -7 / 3 = -2, -7 % 3 = -1
    ro dr = (-7).to_bigint().div_rem((3).to_bigint())
    match dr {
        Ok((q, r)) => {
            assert(q == (-2).to_bigint())
            assert(r == (-1).to_bigint())
        }
        Err(_) => assert(false)
    }
    // 7 / -3 = -2, 7 % -3 = 1
    ro dr2 = (7).to_bigint().div_rem((-3).to_bigint())
    match dr2 {
        Ok((q, r)) => {
            assert(q == (-2).to_bigint())
            assert(r == (1).to_bigint())
        }
        Err(_) => assert(false)
    }
    // -7 / -3 = 2, -7 % -3 = -1
    ro dr3 = (-7).to_bigint().div_rem((-3).to_bigint())
    match dr3 {
        Ok((q, r)) => {
            assert(q == (2).to_bigint())
            assert(r == (-1).to_bigint())
        }
        Err(_) => assert(false)
    }
}

test "div и rem: явные методы" {
    ro d = (100).to_bigint().div((3).to_bigint())
    match d {
        Ok(q) => assert(q == (33).to_bigint())
        Err(_) => assert(false)
    }
    ro r = (100).to_bigint().rem((3).to_bigint())
    match r {
        Ok(rm) => assert(rm == (1).to_bigint())
        Err(_) => assert(false)
    }
}

// ── Строки ─────────────────────────────────────────────────────────────────

test "str to_bigint: ноль" {
    ro r = "0".to_bigint()
    match r {
        Ok(v) => assert(v.is_zero())
        Err(_) => assert(false)
    }
    ro r2 = "00".to_bigint()
    match r2 {
        Ok(v) => assert(v.is_zero())
        Err(_) => assert(false)
    }
}

test "str to_bigint: простые" {
    ro r = "42".to_bigint()
    match r {
        Ok(v) => assert(v == (42).to_bigint())
        Err(_) => assert(false)
    }
    ro r2 = "-42".to_bigint()
    match r2 {
        Ok(v) => assert(v == (-42).to_bigint())
        Err(_) => assert(false)
    }
}

test "str to_bigint: большие" {
    ro r = "12345678901234567890".to_bigint()
    match r {
        Ok(v) => assert(!v.is_zero())
        Err(_) => assert(false)
    }
}

test "str to_bigint: ошибки" {
    match "".to_bigint() {
        Err(Empty) => assert(true)
        _ => assert(false)
    }
    match "-".to_bigint() {
        Err(OnlySign) => assert(true)
        _ => assert(false)
    }
    match "+".to_bigint() {
        Err(OnlySign) => assert(true)
        _ => assert(false)
    }
    match "12a34".to_bigint() {
        Err(InvalidCharacter) => assert(true)
        _ => assert(false)
    }
}

test "to_str: простые" {
    assert(BigInt.zero().to_str() == "0")
    assert(BigInt.one().to_str() == "1")
    assert((-BigInt.one()).to_str() == "-1")
    assert((42).to_bigint().to_str() == "42")
    assert((-42).to_bigint().to_str() == "-42")
}

test "to_str: большие" {
    ro v = (12345678901234567890 as u64).to_bigint()
    assert(v.to_str() == "12345678901234567890")
}

// ── Мутирующие операции ────────────────────────────────────────────────────




// ── pow ────────────────────────────────────────────────────────────────────

test "pow: простые" {
    assert((2).to_bigint().pow(0) == BigInt.one())
    assert((2).to_bigint().pow(1) == (2).to_bigint())
    assert((2).to_bigint().pow(3) == (8).to_bigint())
    assert((-2).to_bigint().pow(3) == (-8).to_bigint())
    assert((-2).to_bigint().pow(4) == (16).to_bigint())
}

// ── Деление — крайние случаи ──────────────────────────────────────────────

test "div_rem: делитель длиннее делимого" {
    // |a| < |b|, частное = 0, остаток = a
    ro a = (100).to_bigint()
    ro b = (0xFFFFFFFF as u64).to_bigint() * (0xFFFFFFFF as u64).to_bigint()
    ro dr = a.div_rem(b)
    match dr {
        Ok((q, r)) => {
            assert(q.is_zero())
            assert(r == a)
        }
        Err(_) => assert(false)
    }
}

test "div_rem: равные числа" {
    ro a = (12345).to_bigint()
    ro dr = a.div_rem(a)
    match dr {
        Ok((q, r)) => {
            assert(q == BigInt.one())
            assert(r.is_zero())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: степень двойки" {
    ro a = (1024).to_bigint()
    ro b = (2).to_bigint()
    ro dr = a.div_rem(b)
    match dr {
        Ok((q, r)) => {
            assert(q == (512).to_bigint())
            assert(r.is_zero())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: одна цифра делителя" {
    ro a = (999999).to_bigint()
    ro b = (9).to_bigint()
    ro dr = a.div_rem(b)
    match dr {
        Ok((q, r)) => {
            assert(q == (111111).to_bigint())
            assert(r.is_zero())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: операнды разной длины" {
    // a большое, b маленькое
    ro a = (0xFFFFFFFF as u64).to_bigint() * (0xFFFFFFFF as u64).to_bigint()
    ro b = (3).to_bigint()
    ro dr = a.div_rem(b)
    match dr {
        Ok((q, r)) => {
            // identity: a == q * b + r
            assert(a == q * b + r)
        }
        Err(_) => assert(false)
    }
}

test "div_rem: отрицательное / положительное" {
    ro dr = (-100).to_bigint().div_rem((7).to_bigint())
    match dr {
        Ok((q, r)) => {
            // trunc-к-нулю: -100/7 = -14, -100%7 = -2
            // -14*7 + (-2) = -98 - 2 = -100 ✓
            ro check = q * (7).to_bigint() + r == (-100).to_bigint()
            assert(check)
            assert(q == (-14).to_bigint())
            assert(r == (-2).to_bigint())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: положительное / отрицательное" {
    ro dr = (100).to_bigint().div_rem((-7).to_bigint())
    match dr {
        Ok((q, r)) => {
            // trunc-к-нулю: 100/-7 = -14, 100%-7 = 2
            // -14*(-7) + 2 = 98 + 2 = 100 ✓
            ro check = q * (-7).to_bigint() + r == (100).to_bigint()
            assert(check)
            assert(q == (-14).to_bigint())
            assert(r == (2).to_bigint())
        }
        Err(_) => assert(false)
    }
}

test "div_rem: оба отрицательных" {
    ro dr = (-100).to_bigint().div_rem((-7).to_bigint())
    match dr {
        Ok((q, r)) => {
            // trunc-к-нулю: -100/-7 = 14, -100%-7 = -2
            // 14*(-7) + (-2) = -98 - 2 = -100 ✓
            ro check = q * (-7).to_bigint() + r == (-100).to_bigint()
            assert(check)
            assert(q == (14).to_bigint())
            assert(r == (-2).to_bigint())
        }
        Err(_) => assert(false)
    }
}

// ── Самоприсваивание ───────────────────────────────────────────────────────




// ── Раунд-трип строк ─────────────────────────────────────────────────────

test "to_str round-trip: степени десяти" {
    ro p1 = "1".to_bigint()
    match p1 { Ok(v) => assert(v.to_str() == "1"); Err(_) => assert(false) }
    ro p2 = "10".to_bigint()
    match p2 { Ok(v) => assert(v.to_str() == "10"); Err(_) => assert(false) }
    ro p3 = "100".to_bigint()
    match p3 { Ok(v) => assert(v.to_str() == "100"); Err(_) => assert(false) }
    ro p4 = "1000000".to_bigint()
    match p4 { Ok(v) => assert(v.to_str() == "1000000"); Err(_) => assert(false) }
    ro p5 = "1000000000".to_bigint()
    match p5 { Ok(v) => assert(v.to_str() == "1000000000"); Err(_) => assert(false) }
    ro p6 = "10000000000000000000".to_bigint()
    match p6 { Ok(v) => assert(v.to_str() == "10000000000000000000"); Err(_) => assert(false) }
}

test "to_str round-trip: большие числа" {
    ro s = "123456789012345678901234567890"
    ro parsed = s.to_bigint()
    match parsed {
        Ok(v) => {
            ro result = v.to_str()
            assert(result == s)
        }
        Err(_) => assert(false)
    }
}

test "to_str round-trip: отрицательные" {
    ro s = "-98765432109876543210"
    ro parsed = s.to_bigint()
    match parsed {
        Ok(v) => {
            ro result = v.to_str()
            assert(result == s)
        }
        Err(_) => assert(false)
    }
}

// ── Инварианты представления ───────────────────────────────────────────────

test "invariant: нет ведущих нулевых лимбов" {
    ro a = (256).to_bigint()
    // a.limbs = [0, 1] после нормализации должно быть [0, 1]
    // Убеждаемся, что нет ведущих нулей
    if a.limbs.len() > 0 {
        assert(a.limbs[a.limbs.len() - 1] != 0)
    }
    // После mul
    ro p = a * (2).to_bigint()
    if p.limbs.len() > 0 {
        assert(p.limbs[p.limbs.len() - 1] != 0)
    }
}

test "invariant: ноль === Zero + пустые лимбы" {
    ro z = BigInt.zero()
    ro zs = z.sign()
    match zs { Zero => assert(true); _ => assert(false) }
    assert(z.limbs.len() == 0)

    ro z2 = (5).to_bigint() + (-5).to_bigint()
    ro z2s = z2.sign()
    match z2s { Zero => assert(true); _ => assert(false) }
    assert(z2.limbs.len() == 0)

    ro z3 = (5).to_bigint() * (0).to_bigint()
    ro z3s = z3.sign()
    match z3s { Zero => assert(true); _ => assert(false) }
}

// ── Операторные desugar ────────────────────────────────────────────────────

test "operator: + - * < > == !=" {
    ro a = (42).to_bigint()
    ro b = (10).to_bigint()
    assert(a + b == (52).to_bigint())
    assert(a - b == (32).to_bigint())
    assert(a * b == (420).to_bigint())
    assert(a > b)
    assert(b < a)
    assert(a == a)
    assert(a != b)
}

// ── Знак: -0 не возникает ─────────────────────────────────────────────────

test "zero is canonical" {
    // Ноль после любой операции должен иметь Zero + пустые limbs
    ro z1 = BigInt.zero()
    ro z1s = z1.sign()
    match z1s { Zero => assert(true); _ => assert(false) }
    assert(z1.limbs.len() == 0)

    ro z2 = (0).to_bigint()
    ro z2s = z2.sign()
    match z2s { Zero => assert(true); _ => assert(false) }
    assert(z2.limbs.len() == 0)

    ro z3 = (5).to_bigint() + (-5).to_bigint()
    ro z3s = z3.sign()
    match z3s { Zero => assert(true); _ => assert(false) }
    assert(z3.limbs.len() == 0)

    ro z4 = (5).to_bigint() - (5).to_bigint()
    assert(z4.is_zero())
}

// ── Identity-тесты ─────────────────────────────────────────────────────────

test "identity: (a+b)-b == a" {
    ro a = (100).to_bigint()
    ro b = (37).to_bigint()
    assert((a + b) - b == a)
    assert((a - b) + b == a)
}

test "identity: (a*b)/b == a div_rem" {
    ro a = (42).to_bigint()
    ro b = (7).to_bigint()
    ro prod = a * b
    ro dr = prod.div_rem(b)
    match dr {
        Ok((q, r)) => {
            assert(q == a)
            assert(r.is_zero())
        }
        Err(_) => assert(false)
    }
}

// ── Кнут D (vn ≥ 2): направленные вектора — фикс 2026-07-31 ─────────────────
// Прежние div-тесты были ТОЛЬКО с однолимбовыми делителями (short-path n==1);
// Кнут-путь не покрывался вовсе и нёс три дефекта: цикл шёл снизу вверх,
// двойной push при carry≠0, возврат неразвёрнутого остатка (мёртвый r_rev).
// Эталоны — Python (произвольная точность), не эта реализация.

test "div_rem Кнут: 2-лимбовый делитель, 2-лимбовый остаток" {
    ro a = "106048574344139162996".to_bigint()!!
    ro b = "8589934599".to_bigint()!!
    ro (q, r) = a.div_rem(b)!!
    assert(q.to_str() == "12345678901")
    assert(r.to_str() == "4294967297")
}

test "div_rem Кнут: делитель у границы лимба" {
    ro a = "18446744073709563961".to_bigint()!!
    ro b = "8589934599".to_bigint()!!
    ro (q, r) = a.div_rem(b)!!
    assert(q.to_str() == "2147483646")
    assert(r.to_str() == "2147496007")
}

test "div_rem Кнут: 3-лимбовый делитель" {
    ro a = "1427247692705959881058285969449495137370400945".to_bigint()!!
    ro b = "1208925819614629174706189".to_bigint()!!
    ro (q, r) = a.div_rem(b)!!
    assert(q.to_str() == "1180591620717411303423")
    assert(r.to_str() == "1193578128545303815415998")
}

test "div_rem Кнут: малый старший лимб делителя (максимальный shift)" {
    ro a = "1267650600228229401496703205381".to_bigint()!!
    ro b = "18446744073709551617".to_bigint()!!
    ro (q, r) = a.div_rem(b)!!
    assert(q.to_str() == "68719476735")
    assert(r.to_str() == "18446744004990074886")
}

test "div_rem Кнут: carry при нормализации делимого (u*d переносит)" {
    ro a = "680564734554930389555128253205431975935".to_bigint()!!
    ro b = "8589934601".to_bigint()!!
    ro (q, r) = a.div_rem(b)!!
    assert(q.to_str() == "79228162514264337593543950335")
    assert(r.to_str() == "8589934600")
}

test "div_rem Кнут: тождество q*b + r == a на всех векторах" {
    ro pairs = [
        ("106048574344139162996", "8589934599"),
        ("1427247692705959881058285969449495137370400945", "1208925819614629174706189"),
        ("1267650600228229401496703205381", "18446744073709551617"),
        ("680564734554930389555128253205431975935", "8589934601"),
    ]
    for p in pairs {
        ro (sa, sb) = p
        ro a = sa.to_bigint()!!
        ro b = sb.to_bigint()!!
        ro (q, r) = a.div_rem(b)!!
        assert(q.times(b).plus(r).equal(a))
        assert(r.compare(b) < 0)
    }
}

// ── @gcd (Ф.1 плана 240): Евклид через @rem ────────────────────────────────

test "gcd: известные пары" {
    ro pairs = [
        (48, 36, 12),
        (1071, 462, 21),
        (17, 5, 1),
        (12, 18, 6),
        (2, 2, 2),
        (1, 1, 1),
    ]
    for p in pairs {
        ro (av, bv, gv) = p
        ro a = (av).to_bigint()
        ro b = (bv).to_bigint()
        assert(a.gcd(b).equal((gv).to_bigint()))
    }
}

test "gcd: 0-кейсы" {
    assert((0).to_bigint().gcd((0).to_bigint()).is_zero())
    assert((0).to_bigint().gcd((5).to_bigint()).equal((5).to_bigint()))
    assert((5).to_bigint().gcd((0).to_bigint()).equal((5).to_bigint()))
    assert((-5).to_bigint().gcd((0).to_bigint()).equal((5).to_bigint()))
}

test "gcd: знаки — результат неотрицателен" {
    ro a = (-48).to_bigint()
    ro b = (-36).to_bigint()
    ro g = a.gcd(b)
    assert(g.equal((12).to_bigint()))
    assert(g.is_pos())
    assert((-48).to_bigint().gcd((36).to_bigint()).equal((12).to_bigint()))
    assert((48).to_bigint().gcd((-36).to_bigint()).equal((12).to_bigint()))
}

test "gcd: большие числа — степени двойки и взаимно-простые" {
    ro a = BigInt.one().shl(100)
    ro b = BigInt.one().shl(60)
    assert(a.gcd(b).equal(b))
    ro m1 = "100000000000000000001".to_bigint()!!
    ro m2 = "100000000000000000003".to_bigint()!!
    assert(m1.gcd(m2).is_one())
}

test "gcd: Евклидово тождество gcd(a,b) == gcd(b, a % b)" {
    ro a = "1427247692705959881058285969449495137370400945".to_bigint()!!
    ro b = "1208925819614629174706189".to_bigint()!!
    ro g1 = a.gcd(b)
    ro r = a.rem(b)!!
    ro g2 = b.gcd(r)
    assert(g1.equal(g2))
    assert(a.rem(g1)!!.is_zero())
    assert(b.rem(g1)!!.is_zero())
}

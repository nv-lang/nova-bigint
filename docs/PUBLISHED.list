# Канон публикации docs/ пакета nova-bignum на сайт (по образцу
# nova-polaris/docs/PUBLISHED.list). Один slug в строке = страница
# публикуется В ОБЕИХ языковых версиях (X.md + X.ru.md). Страж
# doc-conventions краснеет, если у файла из списка нет пары. www-синк
# читает ЭТОТ файл (никаких зеркал-констант в репе сайта).
# Исключение = строка, закомментированная '#' с причиной.
bigdecimal
bigfloat
bigint
bigrat
overview
